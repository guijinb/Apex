# Apex 环境变量示例
# 说明：此文件仅作示例，请勿提交真实值到仓库

# 运行环境：production / development
ENVIRONMENT=production

# 站点公开地址（用于验证邮件链接、CSP、canonical 等）
PUBLIC_BASE_URL=https://apex-8rg.pages.dev

# CORS 允许来源（逗号分隔，留空表示同源策略，不允许跨域）
ALLOWED_ORIGINS=

# CAPTCHA 签名密钥（32+ 字节随机十六进制）
CAPTCHA_SECRET=change-me-32-bytes-hex

# 邮件服务商顺序：resend 主、agentmail 备
# 可用值：resend, agentmail
# 默认：resend,agentmail
EMAIL_PROVIDER=resend,agentmail

# 发件人信息
EMAIL_FROM=Apex Entertainment <noreply@apex.example.com>
EMAIL_REPLY_TO=support@apex.example.com

# Resend（主）
RESEND_API_KEY=re_xxx

# AgentMail（备）
AGENTMAIL_API_KEY=am_us_xxx
AGENTMAIL_INBOX_ID=inbox_xxx

# 开发模式下是否允许在 API 响应中返回 reset code / verify token
# 生产环境必须为 false
DEV_SHOW_RESET_CODE=false
